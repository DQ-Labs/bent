{
  "name": "bent",
  "version": "0.1.0",
  "description": "Circuit-bent video synthesizer, live Traktor Kontrol F1 VJ instrument, and FL Studio-style Piano Roll visual timeline",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "author": "DQ Labs",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.dqlabs.bent",
    "productName": "Bent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bent"
    }
  }
}
